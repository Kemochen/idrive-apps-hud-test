{
  "proxies": {
    "de.bmw.infotainment.telematic.oapcontroller.OAPController": "*",
    "de.bmw.infotainment.hmi.remote.RemoteHmi": "*",
    "de.bmw.infotainment.hmi.remote.RemoteHmiApplication": "*",
    "de.bmw.infotainment.hmi.entrypoint.EntryPoint": "*",
    "de.bmw.infotainment.hmi.entrypoint.EntryPointManager": "*",
    "de.bmw.infotainment.hmi.resourcemanagement.ResourceManager": "*",
    "de.bmw.infotainment.hmi.resourcemanagement.ResourceBundle": "*",
    "de.bmw.infotainment.hmi.resourcemanagement.StringBundle": "*",
    "de.bmw.infotainment.hmi.hmicontext.HMIContext": {
      "instances": [
        "HMI_CID"
      ],
      "attributes": {
        "currentDisplayLanguage": "rs"
      }
    },
    "de.bmw.infotainment.telematic.oap.PrivateEntryPoint": {
      "instances": [
        "${userId}"
      ],
      "methods": [
        "registerEntryPoint",
        "unregisterEntryPoint",
        "setSelected",
        "setAvailability"
      ]
    },
    "de.bmw.infotainment.telematic.oap.AppBookmarks": {
      "instances": [
        "${userId}"
      ],
      "methods": [
        "registerBookmark"
      ]
    },
    "de.bmw.infotainment.telematic.oap.WakeUpOnDemand": {
      "instances": [
        "${userId}"
      ],
      "methods": [
        "registerParticipant",
        "unregisterParticipant"
      ]
    },
    "de.bmw.infotainment.telematic.oap.WodControl": {
      "instances": "${userId}",
      "methods": [
        "offerService",
        "stopOfferingService"
      ]
    },
    "de.bmw.infotainment.telematic.provisioning.Provisioning": {
      "instances": "1",
      "broadcasts": [
        "provisioningDataJSON"
      ],
      "methods": [
        "getValueJSON",
        "setFilterForProvisioningData"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle": "*",
    "de.bmw.infrastructure.EnvironmentalInformation": "*",
    "de.bmw.infotainment.certification.Certification": "*",
    "de.bmw.infotainment.personalization.SessionManager": {
      "instances": "*",
      "attributes": "*"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "instances": [
        "1"
      ],
      "attributes": {
        "statusFESVehicleDynamicSwitchHMI": "rs"
      }
    },
    "de.bmw.infotainment.navigation.guiding.GuidanceEventList": {
      "instances": [
        "Main_Instance"
      ],
      "methods": [
        "queryContent"
      ]
    },
    "de.bmw.infotainment.navigation.guiding.Guidance": {
      "instances": [
        "Main_Instance"
      ],
      "attributes": {
        "currentLaneGuiding": "rs",
        "guidingProvider": "rs",
        "guidanceState": "rs",
        "conclusiveDart": "rs"
      }
    },
    "de.bmw.infotainment.a4a.carplay.CarPlayManager": {
      "instances": [
        "CarPlayManagerInst1"
      ],
      "attributes": {
        "projectedGuidanceActive": "rs",
        "projectedGuidanceMetadataAvailable": "rs"
      }
    },
    "de.bmw.infotainment.sdi.aap.androidautoprojectedmanager.AndroidAutoProjectedManager": {
      "instances": [
        "AndroidAutoProjectedManagerInst1"
      ],
      "attributes": {
        "projectedGuidanceActive": "rs"
      }
    },
    "de.bmw.infotainment.navigation.projectedmodeguiding.ProjectedModeGuiding": {
      "instances": [
        "Main_Instance"
      ],
      "attributes": {
        "currentLaneGuiding": "rs"
      }
    }
  },
  "services": {
    "de.bmw.infotainment.telematic.oap.AppStatus": {
      "instances": [
        "${userId}"
      ]
    }
  }
}
